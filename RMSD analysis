            fh.write(f"    median = {col.median():.3f} Å\n")
            fh.write(f"    max    = {col.max():.3f} Å\n")

    print(f"[✓] RMSD summary         → {summary_path}")
    if missing_backbones:
        print(f"\n[!] {len(missing_backbones)} design(s) had no matching backbone PDB.")

    return df_valid


# ===========================================================================
# CLI
# ===========================================================================

def parse_args():
    p = argparse.ArgumentParser(
        description="Compare AF3 predictions to RFdiffusion backbones via RMSD.")
    p.add_argument("--backbones",    required=True)
    p.add_argument("--af3_dir",      required=True)
    p.add_argument("--output",       default="./rmsd_results")
    p.add_argument("--threshold",    type=float, default=11.0,
                   help="binding_site_rmsd threshold for 'promising' flag (default: 2.0 Å)")
    p.add_argument("--top_n",        type=int,   default=10)
    p.add_argument("--binder_chain", default=DEFAULT_BINDER_CHAIN)
    p.add_argument("--target_chain", default=DEFAULT_TARGET_CHAIN)
    p.add_argument("--cif_filename", default="*_complex_model.cif")
    p.add_argument("--af3_summary",  default=None,
                   help="Path to Job2 AF3 summary CSV to merge with RMSD scores")
    return p.parse_args()


if __name__ == "__main__":
    args = parse_args()
    df = run_analysis(
        backbone_dir = args.backbones,
        af3_dir      = args.af3_dir,
        output_dir   = args.output,
        cif_filename = args.cif_filename,
        binder_chain = args.binder_chain,
        target_chain = args.target_chain,
        threshold    = args.threshold,
        top_n        = args.top_n,
        af3_summary  = args.af3_summary,
    )
    n = int(df["promising"].sum()) if "promising" in df.columns else 0
    print(f"\nDone. {n} promising hit(s). See {args.output}/")
