        HEADER_FONT = Font(bold=True, color="FFFFFF", name="Arial", size=10)
        DATA_FONT   = Font(name="Arial", size=10)
        BOLD_FONT   = Font(name="Arial", size=10, bold=True)

        wb = Workbook()
        ws = wb.active
        ws.title = "AF3 + RMSD Results"

        # Sort by ipsae descending (best binders first), matching original AF3 output
        sort_col = None
        for candidate in ["ipsae", "ipSAE", "IPSAE", "iptm", "ipTM",
                          "mean_plddt", "ranking_score"]:
            if candidate in combined_df.columns:
                sort_col = candidate
                break

        if sort_col:
            display_df = combined_df.sort_values(sort_col, ascending=False).copy()
        else:
