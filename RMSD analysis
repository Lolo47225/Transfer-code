        fh.write("-" * 75 + "\n")
        fh.write(f"TOP {top_n} BY binding_site_rmsd\n")
        fh.write("-" * 75 + "\n")
        for _, r in df_valid.head(top_n).iterrows():
            flag = "  *** PROMISING ***" if r.get("promising") else ""
            fh.write(f"\n  Rank {int(r['rank']):>4}  {r['design_name']}{flag}\n")
            seq = r.get("binder_sequence")
            if pd.notna(seq) and seq:
                fh.write(f"    sequence          : {seq}\n")
            bs  = r.get("binding_site_rmsd")
            bsh = r.get("binder_shape_rmsd")
            fh.write(f"    binding_site_rmsd : "
                     f"{bs:.3f} Å  ← PRIMARY\n" if pd.notna(bs)
                     else "    binding_site_rmsd : N/A\n")
            fh.write(f"    binder_shape_rmsd : "
                     f"{bsh:.3f} Å\n" if pd.notna(bsh)
                     else "    binder_shape_rmsd : N/A\n")

        fh.write("\n" + "-" * 75 + "\n")
        fh.write("STATISTICS\n")
        fh.write("-" * 75 + "\n")
        for metric, label in [
            ("binding_site_rmsd", "Binding site RMSD (PRIMARY)"),
            ("binder_shape_rmsd", "Binder shape RMSD"),
