            ["ipsae_d0dom",
             "ipSAE normalised using d0 calculated per domain. Similar to "
             "ipsae_d0chn but uses domain-level normalisation. Useful when "
             "comparing across structurally distinct binder classes.",
             "Lower is better"],
            ["complex_iptm",
             "Interface predicted TM-score for the full complex. Measures "
             "confidence in the relative orientation of the two chains. "
             "Higher = more confident the binder and KRAS are correctly "
             "positioned relative to each other.",
             "0-1. > 0.8 excellent. > 0.6 acceptable"],
            ["complex_ptm",
             "Predicted TM-score for the full complex structure overall. "
             "Global confidence metric across both chains combined.",
             "0-1. Higher is better"],
            ["complex_ranking_score",
             "AF3 composite ranking score for the complex prediction. Weighted "
             "combination of ptm and iptm used internally by AF3 to rank "
             "multiple predictions of the same sequence.",
             "Higher is better"],
            ["complex_frac_disordered",
             "Fraction of residues in the complex predicted to be disordered "
             "(low pLDDT). High values suggest the binder may not adopt a "
             "stable fold when bound to KRAS.",
             "Lower is better. < 0.1 good"],
            ["apo_ptm",
             "Predicted TM-score for the binder alone (apo = unbound state). "
             "Measures confidence in the binder's intrinsic fold independent "
             "of KRAS. Cyclic peptides should have moderate-high apo_ptm if "
             "they are pre-organised for binding.",
             "0-1. Higher is better"],
            ["apo_ranking_score",
             "AF3 composite ranking score for the binder in its apo (unbound) "
