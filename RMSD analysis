             "Higher is better"],
            ["n_samples",
             "Number of AF3 predictions generated for this sequence. "
             "The best-scoring model (by complex_ranking_score) was used "
             "for RMSD analysis.",
             "Typically 5 or 20"],
            ["binder_sequence",
             "Amino acid sequence of the cyclic peptide binder (chain B), "
             "read directly from the AF3 CIF model that was analysed.",
             ""],
            ["job",
             "Job/design identifier linking back to the CyclicMPNN sequence "
             "generation run.",
             ""],
